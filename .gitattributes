# Large research artifacts should use Git LFS when committed.
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.cbm filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text

# Keep text-based research formats diffable.
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.py text eol=lf
*.R text eol=lf
*.js text eol=lf
